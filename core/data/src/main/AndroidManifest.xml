<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Declared here rather than only in :app because this is the module that asks
      the question. A permission that lives only in the app is a permission the
      library can lose without anything noticing until it runs.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
